# Export these in your shell or process manager; no .env autoload is performed.
API_ADDR=127.0.0.1:8080
# Same-origin frontend proxy is the default. Set this only for an explicitly trusted origin.
FRONTEND_ORIGIN=http://localhost:3000
# SHOP_DB=/absolute/path/to/shop.db
# COOKIE_SECURE=1
# ADMIN_EMAIL=owner@example.com
# ADMIN_PASSWORD=choose-a-strong-password
# WhatsApp can be set in store-config.json instead; it is read on each payment click.
# WHATSAPP_NUMBER=12025550123
# API_PROXY_TARGET=http://127.0.0.1:8080
